# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — create a project at supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# (older projects: use NEXT_PUBLIC_SUPABASE_ANON_KEY instead)
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (keep key server-side only)
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Paystack (use TEST keys first; secret key must never be public)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Currency amount in kobo for Paystack. Example starter pricing:
PAYSTACK_STARTER_AMOUNT_KOBO=500000
PAYSTACK_PRO_AMOUNT_KOBO=1500000
